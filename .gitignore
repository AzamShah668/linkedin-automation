# Secrets — NEVER commit
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
token.json
# Loose key files pasted at the repo root. `*.key` does NOT cover an extensionless
# file literally named "api key" - one appeared on 2026-08-13, untracked but NOT
# ignored, i.e. one `git add .` from being public. Secrets belong in .env.
api key
api-key*
apikey*
*api?key*
*.token
secrets.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── PERSONAL DATA — never commit to the public repo ──────────────────────────
# This repo is PUBLIC. `output/` and `profile/` hold real job-hunt data: the
# owner's CV and contact details, and the names, emails and LinkedIn URLs of
# real recruiters who never agreed to appear in a public repository.
# Everything the code needs is generated at runtime; nothing here is required
# to run the pipeline. See README.md → "What is not in this repo".
output/
# NOTE: use `profile/*` not `profile/` — git cannot re-include a file whose
# parent DIRECTORY is excluded, so the two `!` lines below would silently fail.
profile/*
!profile/README.md
!profile/application-answers.example.json

# Data / generated artifacts
data/*.db
data/*.sqlite
data/generated/
data/cache/

# Claude Code local settings (machine-specific permission allowlist)
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.pw_browser/
.pw-output/

# Obsidian vault junk that landed in the repo folder by accident
.obsidian/
linkdin automation/

# graphify derived cache - regenerates from source, no value in history
graphify-out/cache/

# The board mirror moved out of output/ into database/ (2026-08-11) so a cleanup of generated
# files can never delete the store the whole pipeline plans from. It must stay ignored: the
# `notes` column holds REAL RECRUITER NAMES on 17 rows, and this repo is public.
# The schema and access layer (database/board_db.py) ARE tracked. The data is not.
database/*.sqlite3
database/*.sqlite
database/*.db

# Stray screenshots dropped at the repo ROOT by browser automation. On 2026-08-14 a
# `groq-login.png` sat here showing BOTH of the owner's email addresses - untracked but
# not ignored, i.e. one `git add .` from a public repo. Same shape as the `api key` file
# above. Root only, so real assets under subdirectories are unaffected.
/*.png
/*.jpg
/*.jpeg
/*.webp

# Run artifacts and LinkedIn scrape dumps at the repo root. They hold company/role data
# and are regenerated every run. Untracked-but-not-ignored at the root is the exact shape
# that put an `api key` file and a groq-login.png one `git add .` from a public repo.
apply-run*.log
survey-run*.log
*-run-2026-*.log
jobs-*.json
scrape-*.json
devops-india.json
.pw-output/
