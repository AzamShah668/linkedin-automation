# Copy to .env and fill in. NEVER commit the real .env.

# --- Claude API ---
ANTHROPIC_API_KEY=

# --- The autopilot's LLM slot (apps/autopilot/llm.py: fit scoring, odd form questions) ---
# Read by ask(). Phase 0 makes zero LLM calls, so these stay empty until Phase 1.
#
# OmniRoute (local gateway, free/pooled providers) is the intended default - see
# docs/knowledge/29-omniroute-gateway.md. Start it with `omniroute`, then:
#
#   LLM_BASE_URL=http://localhost:20128/v1     <- WITH /v1. This is the OpenAI-compatible
#                                                 path, used by the `openai` client below.
#                                                 Claude Code's ANTHROPIC_BASE_URL is the
#                                                 SAME host with NO /v1. Do not copy one
#                                                 into the other; both fail confusingly.
#   LLM_MODEL=<a pinned model id>              <- NOT `auto/*`. See below.
#
# ⚠️ NEVER set LLM_MODEL to an `auto/*` id. Auto-routing picks a different provider on every
# call and they are not equally correct - one sweep hit silent truncation, 403, 429 and 418
# across three ids. Pin a model that passes:  py -3 tools/omniroute_canary.py --all
#
# NEVER point this at a paid key by accident: this is the high-frequency path.
LLM_PROVIDER=openrouter
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# true (default) | false. There is no universally correct value: measured 2026-08-13, felo
# eats the first token when NOT streamed, groq streams nothing but keepalives. The canary
# prints the safe pairing per model. Streaming is the default because its failure is loud.
LLM_STREAM=true

# --- Fallback endpoint (optional; tried ONLY when the one above fails outright) ---
# ⚠️ Do NOT point this at another OmniRoute model. The gateway is a LOCAL process: when the
# laptop sleeps (it once slept a whole day - D20) or the npm process dies, every model
# behind it dies together, "fallbacks" included. This must be a different road.
#
# Groq direct is the proven one. Measured 2026-08-14: the same key answers exactly through
# api.groq.com in BOTH transports and returns 403 on every completion through OmniRoute -
# the gateway is what breaks it, not the key (D43). Free tier, 30 req/min, no gateway.
# Ignored unless BOTH the URL and the MODEL are set.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_STREAM=true

# --- Raw provider keys (used directly, and to fill the slots above) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Slack notifications (bot token + channel ID; read by tools/slack_notify.py) ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Gmail outreach (OAuth handled separately; note the sending address) ---
GMAIL_SENDER=azamshah25809@gmail.com

# --- Job board APIs (optional; add as each adapter is built) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=

# --- Runtime safeguards ---
DAILY_OUTREACH_CAP=15
MIN_SECONDS_BETWEEN_SENDS=45
FIT_SCORE_THRESHOLD=70

# --- Outreach throttling (recruiter-outreach dual-touch) ---
# Randomized extra delay added to every send (0..N sec); LinkedIn connects are the scarcest budget.
OUTREACH_JITTER_SECONDS=120
LINKEDIN_CONNECTS_DAILY_CAP=5

# --- Two-stage accept watch (tools/invite_tracker.py + watch-accepts.ps1) ---
# Stage 1 sends a BARE connection request (a request with a note is capped at 3/month on a free account);
# stage 2 delivers the real pitch once they accept, as a normal DM, which has no cap at all.
# After an accept is detected, wait a random gap in this range before pitching — instant replies read as bots.
ACCEPT_FOLLOWUP_MIN_HOURS=3
ACCEPT_FOLLOWUP_MAX_HOURS=20
# Follow-ups are nudged into these local hours (24h clock). Nobody real sends a CV at 4am.
BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=21
# Pending invites nobody accepted are given up on after this many days -> fall back to email.
INVITE_EXPIRY_DAYS=14
# Hard ceiling on auto-sent follow-ups per run. Low volume is what keeps the account safe.
FOLLOWUPS_DAILY_CAP=3

# --- Notion (optional) ---------------------------------------------------------
# Only needed so the dashboard's "Push to Notion" button can write directly.
# Without it, Notion is reachable only through a Claude session's MCP connector.
# Create an internal integration at notion.so/my-integrations, share the
# "Job Hunt - Autopilot" database with it, then paste the secret here.
NOTION_TOKEN=
